    { "username": "user-epsilon-2", "enabled": true, "email": "user-epsilon-2@example.com", "firstName": "Epsilon", "lastName": "Two", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-epsilon"] },

    { "username": "svc-direct-1", "enabled": true, "email": "svc-direct-1@example.com", "firstName": "Direct", "lastName": "RoleOps", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "realmRoles": ["role-ops"] },
    { "username": "svc-direct-2", "enabled": true, "email": "svc-direct-2@example.com", "firstName": "Direct", "lastName": "RoleBilling", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "realmRoles": ["role-billing"] },
    { "username": "svc-direct-3", "enabled": true, "email": "svc-direct-3@example.com", "firstName": "Direct", "lastName": "RoleViewer", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "realmRoles": ["role-viewer"] },
    { "username": "svc-direct-4", "enabled": true, "email": "svc-direct-4@example.com", "firstName": "Direct", "lastName": "RoleSuperuser", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "realmRoles": ["role-superuser"] }
  ]
}
