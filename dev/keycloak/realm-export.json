{
  "realm": "cambium-dev",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "nexus-admin", "description": "Maps to Nexus's built-in nx-admin role via Cambium's ROLE_MAP" },
      { "name": "role-viewer", "description": "Synthetic bridge role: read-only access, mirrors a group->role pattern" },
      { "name": "role-editor", "description": "Synthetic bridge role: read/write access" },
      { "name": "role-publisher", "description": "Synthetic bridge role: publish access" },
      { "name": "role-auditor", "description": "Synthetic bridge role: audit/read access" },
      { "name": "role-ops", "description": "Synthetic bridge role: used both via group mapping and direct-assignment test users" },
      { "name": "role-billing", "description": "Synthetic bridge role: used both via group mapping and direct-assignment test users" },
      {
        "name": "role-superuser",
        "description": "Composite role bundling role-viewer + role-ops + role-billing, to exercise Cambium's composite-role expansion (both group-mapped and directly-assigned)",
        "composite": true,
        "composites": {
          "realm": ["role-viewer", "role-ops", "role-billing"]
        }
      }
    ]
  },
  "groups": [
    {
      "name": "nexus-admins",
      "realmRoles": ["nexus-admin"]
    },
    {
      "name": "team-alpha",
      "realmRoles": ["role-viewer"]
    },
    {
      "name": "team-beta",
      "realmRoles": ["role-editor"]
    },
    {
      "name": "team-gamma",
      "realmRoles": ["role-publisher"],
      "subGroups": [
        {
          "name": "team-gamma-leads",
          "realmRoles": []
        }
      ]
    },
    {
      "name": "team-delta",
      "realmRoles": ["role-auditor"]
    },
    {
      "name": "team-epsilon",
      "realmRoles": ["role-superuser"]
    }
  ],
  "clients": [
    {
      "clientId": "cambium-sync",
      "name": "Cambium sync daemon (service account, Keycloak Admin API)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-cambium-sync-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "cambium-ropc",
      "name": "Cambium ropc-proxy (dedicated ROPC client, per docs/oidc-proxy-pairing.md)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-cambium-ropc-secret",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-cambium-sync",
      "enabled": true,
      "serviceAccountClientId": "cambium-sync",
      "clientRoles": {
        "realm-management": ["view-users", "query-groups", "query-users", "view-realm"]
      }
    },
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        { "type": "password", "value": "alice-password", "temporary": false }
      ],
      "groups": ["/nexus-admins"]
    },

    { "username": "user-alpha-1", "enabled": true, "email": "user-alpha-1@example.com", "firstName": "Alpha", "lastName": "One", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-alpha"] },
    { "username": "user-alpha-2", "enabled": true, "email": "user-alpha-2@example.com", "firstName": "Alpha", "lastName": "Two", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-alpha"] },
    { "username": "user-alpha-3", "enabled": true, "email": "user-alpha-3@example.com", "firstName": "Alpha", "lastName": "Three", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-alpha"] },

    { "username": "user-beta-1", "enabled": true, "email": "user-beta-1@example.com", "firstName": "Beta", "lastName": "One", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-beta"] },
    { "username": "user-beta-2", "enabled": true, "email": "user-beta-2@example.com", "firstName": "Beta", "lastName": "Two", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-beta"] },
    { "username": "user-beta-3", "enabled": true, "email": "user-beta-3@example.com", "firstName": "Beta", "lastName": "Three", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-beta"] },

    { "username": "user-gamma-1", "enabled": true, "email": "user-gamma-1@example.com", "firstName": "Gamma", "lastName": "One", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-gamma"] },
    { "username": "user-gamma-2", "enabled": true, "email": "user-gamma-2@example.com", "firstName": "Gamma", "lastName": "Two", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-gamma"] },

    { "username": "user-gamma-lead-1", "enabled": true, "email": "user-gamma-lead-1@example.com", "firstName": "GammaLead", "lastName": "One", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-gamma/team-gamma-leads"] },
    { "username": "user-gamma-lead-2", "enabled": true, "email": "user-gamma-lead-2@example.com", "firstName": "GammaLead", "lastName": "Two", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-gamma/team-gamma-leads"] },

