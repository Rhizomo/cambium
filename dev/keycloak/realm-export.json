    { "username": "user-delta-2", "enabled": true, "email": "user-delta-2@example.com", "firstName": "Delta", "lastName": "Two", "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }], "groups": ["/team-delta"] },
